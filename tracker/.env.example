# Farmazed API - Environment Variables
# Copy to .env for local dev (never commit .env)

# GCP
GCP_PROJECT_ID=farmazed
GCS_BUCKET=farmazed-docs

# For local dev only - path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS=./credentials/farmazed-sa.json

# API Keys
ADMIN_KEY=fz-admin-2026
MCP_KEY=fz-mcp-2026

# URLs
PORT=8080
REDIRECT_URL=https://farmazed.com

# CORS origins (comma-separated, optional override)
# ALLOWED_ORIGINS=https://farmazed.com,http://localhost:8092
